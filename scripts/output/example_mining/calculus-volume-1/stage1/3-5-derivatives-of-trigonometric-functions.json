      "item_id": "fs-id1169739303827",
      "kind": "example",
      "title": "Example 3.45",
      "position": 13,
      "nearest_heading": "Higher-Order Derivatives",
      "prompt_text": "Finding Higher-Order Derivatives of $y = \\sin x$ Find the first four derivatives of $y = \\sin x .$",
      "prompt_latex_bits": [
        "y = \\sin x",
        "y = \\sin x .",
        "\\frac{d^{4}}{d x^{4}} \\left(\\right. \\sin x \\left.\\right) = \\frac{d^{8}}{d x^{8}} \\left(\\right. \\sin x \\left.\\right) = \\frac{d^{12}}{d x^{12}} \\left(\\right. \\sin x \\left.\\right) = \\ldots = \\frac{d^{4 n}}{d x^{4 n}} \\left(\\right. \\sin x \\left.\\right) = \\sin x \\\\ \\frac{d^{5}}{d x^{5}} \\left(\\right. \\sin x \\left.\\right) = \\frac{d^{9}}{d x^{9}} \\left(\\right. \\sin x \\left.\\right) = \\frac{d^{13}}{d x^{13}} \\left(\\right. \\sin x \\left.\\right) = \\ldots = \\frac{d^{4 n + 1}}{d x^{4 n + 1}} \\left(\\right. \\sin x \\left.\\right) = \\cos x ."
      ],
      "has_solution": true,
      "source_anchor": "fs-id1169739303827",
      "notes": ""
    },
