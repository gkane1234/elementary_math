        "f (x) = 4^{3 (x - 2)}",
        "g (x) = x^{3}",
        "h (x) = \\left(\\right. \\frac{1}{3} \\left.\\right)^{x}",
        "j (x) = (- 2)^{x}"
      ],
      "has_solution": true,
      "source_anchor": "Example_04_01_01",
      "notes": ""
    },
