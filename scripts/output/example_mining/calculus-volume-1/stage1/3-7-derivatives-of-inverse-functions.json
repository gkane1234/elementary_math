      "item_id": "fs-id1169739208944",
      "kind": "example",
      "title": "Example 3.63",
      "position": 7,
      "nearest_heading": "Derivatives of Inverse Trigonometric Functions",
      "prompt_text": "Derivative of the Inverse Sine Function Use the inverse function theorem to find the derivative of $g (x) = \\sin^{\u22121} x .$",
      "prompt_latex_bits": [
        "g (x) = \\sin^{\u22121} x .",
        "\\cos \\left(\\right. \\sin^{\u22121} x \\left.\\right) = \\sqrt{1 - x^{2}} ,",
        "\\sin^{\u22121} x = \\theta .",
        "\\sin \\theta = x",
        "- \\frac{\\pi}{2} \\leq \\theta \\leq \\frac{\\pi}{2} .",
        "0 < \\theta < \\frac{\\pi}{2} .",
        "\\theta",
        "\\theta ,",
        "1",
        "\\theta",
        "x .",
        "\\theta",
        "\\sqrt{1 - x^{2}} .",
        "\\cos \\left(\\right. \\sin^{\u22121} x \\left.\\right) = \\cos \\theta = \\sqrt{1 - x^{2}} .",
        "\\theta ,",
        "1 ,",
        "\\theta",
        "x ,",
        "\\cos \\left(\\right. \\sin^{\u22121} x \\left.\\right) = \\cos \\theta = \\sqrt{1 - x^{2}} .",
        "- \\frac{\\pi}{2} < \\theta < 0 ,",
        "0 < \u2212 \\theta < \\frac{\\pi}{2}",
        "\\cos \\left(\\right. \\sin^{\u22121} x \\left.\\right) = \\cos \\theta = \\cos \\left(\\right. \u2212 \\theta \\left.\\right) = \\sqrt{1 - x^{2}} .",
        "\\theta = \\frac{\\pi}{2}",
        "\\theta = - \\frac{\\pi}{2} , x = 1",
        "x = \u22121 ,",
        "\\cos \\theta = 0",
        "\\sqrt{1 - x^{2}} = 0 ,",
        "\\cos \\left(\\right. \\sin^{\u22121} x \\left.\\right) = \\cos \\theta = \\sqrt{1 - x^{2}} .",
        "\\theta = 0",
        "x = 0",
        "\\cos \\theta = \\sqrt{1 - 0} = 1",
        "\\cos \\left(\\right. \\sin^{\u22121} x \\left.\\right) = \\sqrt{1 - x^{2}} ."
      ],
      "has_solution": true,
      "source_anchor": "fs-id1169739208944",
      "notes": ""
    },
