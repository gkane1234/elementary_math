    {
      "item_id": "Example_07_03_04",
      "kind": "example",
      "title": "Example 4",
      "position": 6,
      "nearest_heading": "Try It #2",
      "prompt_text": "Verifying a Double-Angle Identity for Tangent Verify the identity: $tan \\left(\\right. 2 \\theta \\left.\\right) = \\frac{2}{cot \\theta - tan \\theta}$",
      "prompt_latex_bits": [
        "tan \\left(\\right. 2 \\theta \\left.\\right) = \\frac{2}{cot \\theta - tan \\theta}",
        "\\frac{2 tan \\theta}{1 - tan^{2} \\theta} = \\frac{2}{cot \\theta - tan \\theta}",
        "\\frac{2}{cot \\theta - tan \\theta} = \\frac{2}{\\frac{1}{tan \\theta} - tan \\theta} \\left(\\right. \\frac{tan \\theta}{tan \\theta} \\left.\\right) \\\\ = \\frac{2 tan \\theta}{\\frac{1}{\\cancel{tan \\theta}} \\left(\\right. \\cancel{tan \\theta} \\left.\\right) - tan \\theta \\left(\\right. tan \\theta \\left.\\right)} \\\\ = \\frac{2 tan \\theta}{1 - tan^{2} \\theta}"
      ],
      "has_solution": true,
      "source_anchor": "Example_07_03_04",
      "notes": ""
    },
