    {
      "item_id": "fs-id1165042301696",
      "kind": "example",
      "title": "Example 3.25",
      "position": 6,
      "nearest_heading": "Integrating an Expression Involving a 2 + x 2 a 2 + x 2",
      "prompt_text": "Evaluating $\\int \\frac{d x}{\\sqrt{1 + x^{2}}}$ Using a Different Substitution Use the substitution $x = \\text{sinh} \\theta$ to evaluate $\\int \\frac{d x}{\\sqrt{1 + x^{2}}} .$",
      "prompt_latex_bits": [
        "\\int \\frac{d x}{\\sqrt{1 + x^{2}}}",
        "x = \\text{sinh} \\theta",
        "\\int \\frac{d x}{\\sqrt{1 + x^{2}}} .",
        "x = \\tan \\theta .",
        "y = \\text{sinh}^{\u22121} x .",
        "\\text{sinh} y = x .",
        "\\frac{e^{y} - e^{\u2212 y}}{2} = x .",
        "2 e^{y}",
        "e^{2 y} - 2 x e^{y} - 1 = 0 .",
        "e^{y} :",
        "e^{y} = \\frac{2 x \\pm \\sqrt{4 x^{2} + 4}}{2} .",
        "e^{y} = x \\pm \\sqrt{x^{2} + 1} .",
        "x - \\sqrt{x^{2} + 1} < 0 ,",
        "e^{y} = x + \\sqrt{x^{2} + 1} .",
        "y = \\ln \\left(\\right. x + \\sqrt{x^{2} + 1} \\left.\\right) .",
        "\\text{sinh}^{\u22121} x = \\ln \\left(\\right. x + \\sqrt{x^{2} + 1} \\left.\\right) .",
        "x + \\sqrt{x^{2} + 1} > 0 ,",
        "\\ln \\left(\\right. x + \\sqrt{x^{2} + 1} \\left.\\right) = \\ln \\left|\\right. \\sqrt{1 + x^{2}} + x \\left|\\right. ,"
      ],
      "has_solution": true,
      "source_anchor": "fs-id1165042301696",
      "notes": ""
    },
