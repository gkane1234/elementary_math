# Stripe (pay-per-PDF) — payment is required by default
# Run: npm run setup:stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PDF_PRICE_CENTS=300
STRIPE_SUBSCRIPTION_PRICE_CENTS=1000
# Create a Product + recurring $10/mo Price in Stripe Dashboard, then paste the price_... id:
STRIPE_SUBSCRIPTION_PRICE_ID=price_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js (Google OAuth) — required for Pro subscription
# Create OAuth credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set to "true" only to disable payment gating for local development
# STRIPE_PAYMENTS_DISABLED=true
